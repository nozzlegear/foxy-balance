<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>foxy-balance</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- PublishTrimmed=true auto-disables reflection-based JSON serialization.
         Re-enable it since F# doesn't support the System.Text.Json source generator. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="JsonContext.fs" />
    <Compile Include="HttpHandler.fs" />
    <Compile Include="TokenManagement.fs" />
    <Compile Include="HttpClient.fs" />
    <Compile Include="Formatters.fs" />
    <Compile Include="Commands/Auth.fs" />
    <Compile Include="Commands/Balance.fs" />
    <Compile Include="Commands/Transactions.fs" />
    <Compile Include="Commands/Bills.fs" />
    <Compile Include="Commands/Match.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.SystemCommandLine" />
  </ItemGroup>

</Project>
